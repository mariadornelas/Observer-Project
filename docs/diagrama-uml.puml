@startuml diagrama-classes

title Observer - Sensores Industriais (diagrama de classes)

skinparam classAttributeIconSize 0
skinparam linetype ortho

class SensorIndustrial <<Subject>> {
  - tipo: String
  - limiteAlerta: double
  - limiteCritico: double
  - observadores: List<ObservadorSensor>
  + adicionarObservador(observador: ObservadorSensor): void
  + removerObservador(observador: ObservadorSensor): boolean
  + quantidadeDeObservadores(): int
  + medir(valorMedido: double): String
  - notificar(leitura: LeituraSensor): void
  - classificar(valorMedido: double): String
}

interface ObservadorSensor <<Observer>> {
  + atualizar(leitura: LeituraSensor): void
}

class LeituraSensor <<record>> {
  + tipo: String
  + valor: double
  + status: String
}

class PainelDisplay <<Concrete Observer>> {
  - ultimaExibicao: String
  + atualizar(leitura: LeituraSensor): void
  + getUltimaExibicao(): String
}

class RegistroHistorico <<Concrete Observer>> {
  - leituras: List<LeituraSensor>
  + atualizar(leitura: LeituraSensor): void
  + getLeituras(): List<LeituraSensor>
}

class AlarmeSeguranca <<Concrete Observer>> {
  - alarmesDisparados: List<String>
  + atualizar(leitura: LeituraSensor): void
  + getAlarmesDisparados(): List<String>
}

class App <<Cliente>> {
  + {static} main(args: String[]): void
}

SensorIndustrial o-- "0..*" ObservadorSensor : observadores

ObservadorSensor <|.. PainelDisplay
ObservadorSensor <|.. RegistroHistorico
ObservadorSensor <|.. AlarmeSeguranca

SensorIndustrial ..> LeituraSensor : cria e publica
ObservadorSensor ..> LeituraSensor : recebe

App ..> SensorIndustrial : usa
App ..> PainelDisplay : registra
App ..> RegistroHistorico : registra
App ..> AlarmeSeguranca : registra

note right of SensorIndustrial
  O sensor só conhece a interface
  ObservadorSensor, nunca as classes
  concretas. Notifica uma cópia da lista,
  na ordem de registro.
end note

@enduml

@startuml diagrama-sequencia

title Observer - Fluxo de uma medição: medir(75.0)

actor Cliente
participant SensorIndustrial as S
participant PainelDisplay as P
participant RegistroHistorico as H
participant AlarmeSeguranca as A

Cliente -> S : medir(75.0)
activate S
S -> S : classificar(75.0) = "ALERTA"
S -> S : cria LeituraSensor("TEMPERATURA", 75.0, "ALERTA")

S -> P : atualizar(leitura)
P --> S : exibe "[PAINEL] TEMPERATURA = 75.0 (ALERTA)"

S -> H : atualizar(leitura)
H --> S : guarda a leitura

S -> A : atualizar(leitura)
A --> S : status != NORMAL -> dispara alarme

S --> Cliente : "ALERTA"
deactivate S

@enduml
